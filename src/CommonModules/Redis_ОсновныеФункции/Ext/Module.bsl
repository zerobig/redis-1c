#Область СлужебныеПроцедурыИФункции

Функция СоздатьСоединение(АдресСервераRedis, ОписаниеОшибки)

	Соединение = OPI_TCP.ОткрытьСоединение(АдресСервераRedis);
	Если ВыполнениеЗавершилосьОшибкой(Соединение, ОписаниеОшибки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Соединение;

КонецФункции

Процедура Аутентификация(Соединение, Пароль)
	
	Если Не ПустаяСтрока(Пароль) Тогда
		Маркер = Маркер();
		Команда = СтрШаблон("*2%3$4%3AUTH%3$%2%3%1%3",
			Пароль, СтрДлинаВБайтах(Пароль),
			Маркер);
		
		РезультатАутентификации = ВызовСервераRedisДляСоединения(Соединение, Команда);
		ПерваяСтрокаОтвета = СтрПолучитьСтроку(РезультатАутентификации, 1);
		Если Не ПерваяСтрокаОтвета = "+OK" Тогда
			ВызватьИсключение РезультатАутентификации;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ВызовСервераRedis(ПараметрыСоединения, Команда)
	
	ОписаниеОшибки = "";
		
	Соединение = СоздатьСоединение(ПараметрыСоединения.Адрес, ОписаниеОшибки);
	Если Соединение = Неопределено И Не ПустаяСтрока(ОписаниеОшибки) Тогда
		Возврат ОписаниеОшибки;
	КонецЕсли;
	
	Аутентификация(Соединение, ПараметрыСоединения.Пароль);
	
	РезультатВызова = ВызовСервераRedisДляСоединения(Соединение, Команда);
	
	OPI_TCP.ЗакрытьСоединение(Соединение);
	
	Возврат РезультатВызова;
	
КонецФункции

Функция ВызовСервераRedisДляСоединения(Соединение, Команда)

	ОписаниеОшибки = "";
	Маркер = Маркер();

	OPI_TCP.ОтправитьСтроку(Соединение, Команда);
	РезультатОтправкиОшибка = OPI_TCP.ПолучитьПоследнююОшибку(Соединение);
	Если ВыполнениеЗавершилосьОшибкой(РезультатОтправкиОшибка, ОписаниеОшибки) Тогда
		OPI_TCP.ЗакрытьСоединение(Соединение);
		Возврат ОписаниеОшибки;
	КонецЕсли;
	
	РезультатЧтения = OPI_TCP.ПрочитатьСтроку(Соединение,, Маркер);
	РезультатЧтенияОшибка = OPI_TCP.ПолучитьПоследнююОшибку(Соединение);
	Если ВыполнениеЗавершилосьОшибкой(РезультатЧтенияОшибка, ОписаниеОшибки) Тогда
		OPI_TCP.ЗакрытьСоединение(Соединение);
		Возврат ОписаниеОшибки;
	КонецЕсли;

	Возврат РезультатЧтения;
	
КонецФункции

Функция ВыполнениеЗавершилосьОшибкой(Объект, ОписаниеОшибки)
	
	Если ТипЗнч(Объект) = Тип("Соответствие")
		И Не Объект.Получить("error") = Неопределено Тогда

		ОписаниеОшибки = Объект.Получить("error");
		Возврат Истина;
		
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ВозможнаСериализация(Данные)
	
	ТипСтрока = Тип("Строка");

	Если ТипЗнч(Данные) = ТипСтрока Тогда
		Возврат Истина;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		Для каждого ЭлементМассива Из Данные Цикл
			Если Не ТипЗнч(ЭлементМассива) = ТипСтрока Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Возврат Истина;
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура")
		Или ТипЗнч(Данные) = Тип("Соответствие") Тогда
		
		Для каждого КлючЗначение Из Данные Цикл
			Если Не ТипЗнч(КлючЗначение.Ключ) = ТипСтрока
				Или (Не ТипЗнч(КлючЗначение.Значение) = ТипСтрока И Не ТипЗнч(КлючЗначение.Значение) = Тип("Неопределено"))
			Тогда

				Возврат Ложь;
				
			КонецЕсли;
		КонецЦикла;

		Возврат Истина;
	
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция СтрДлинаВБайтах(Стр)
	Возврат Формат(ДлинаВБайтах(Стр), "ЧН=; ЧГ=0");
КонецФункции

Функция ДлинаВБайтах(Стр)
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Стр, КодировкаТекста.UTF8);
	Возврат ДвоичныеДанные.Размер();
КонецФункции

// Не стал использовать никаких регулярных выражений для совместимости
Функция ВозможноСохранениеВСтруктуру(Данные)
	
	ПервыеСимволы = "abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя_";
	ОстальныеСимволы = ПервыеСимволы + "0123456789";
	
	Для каждого КлючЗначение Из Данные Цикл
		Если СтрНайти(ПервыеСимволы, НРег(Лев(КлючЗначение.Ключ, 1))) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Сч = 2 По СтрДлина(КлючЗначение.Ключ) Цикл
			Если СтрНайти(ОстальныеСимволы, НРег(Сред(КлючЗначение.Ключ, Сч, 1))) = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция Маркер()
	
	Возврат Символы.ВК + Символы.ПС;
	
КонецФункции

// TODO: Доделать обработку параметра ПоляЭлементаМассива
Функция РазобратьОтветRedisКакМассив(РезультатВызоваRedis, ПоляЭлементаМассива = "")
	
	ПерваяСтрокаОтвета = СтрПолучитьСтроку(РезультатВызоваRedis, 1);
	КоличествоЭлементов = Число(СтрЗаменить(ПерваяСтрокаОтвета, "*", ""));
	
	СмещениеДляМногострочнхСтрок = 0;
	
	Результат = Новый Массив;
	МассивСтрок = СтрРазделить(РезультатВызоваRedis, Символы.ПС + Символы.ВК, Ложь);
	Для Сч = 1 По КоличествоЭлементов Цикл
		
		ИндексЭлемента = Сч*2 + СмещениеДляМногострочнхСтрок;
		
		ЗначениеЭлементаМассива = МассивСтрок.Получить(ИндексЭлемента);
		ДлинаЗначенияЭлемента = Число(СтрЗаменить(МассивСтрок.Получить(ИндексЭлемента - 1), "$", ""));
		Пока ДлинаЗначенияЭлемента > ДлинаВБайтах(ЗначениеЭлементаМассива) Цикл
			
			СмещениеДляМногострочнхСтрок = СмещениеДляМногострочнхСтрок + 1;
			ИндексЭлемента = Сч*2 + СмещениеДляМногострочнхСтрок;
			
			ЗначениеЭлементаМассива = ЗначениеЭлементаМассива + Символы.ПС + МассивСтрок.Получить(ИндексЭлемента);
			
		КонецЦикла;
		
		Результат.Добавить(ЗначениеЭлементаМассива);
		
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

Процедура ДобавитьКлючиВМассивПоОтветуСКурсором(МассивКлючей, РезультатВызова, НомерПервойСтроки)

	ПерваяСтрокаОтвета = СтрПолучитьСтроку(РезультатВызова, НомерПервойСтроки);
	ЧислоКлючей = Число(СтрЗаменить(ПерваяСтрокаОтвета, "*", ""));
	Для Сч = 1 По ЧислоКлючей Цикл
		МассивКлючей.Добавить(СтрПолучитьСтроку(РезультатВызова, Сч * 2 + НомерПервойСтроки));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти