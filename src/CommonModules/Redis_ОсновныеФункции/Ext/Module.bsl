#Область РаботаСУпорядоченнымиМножествами

// Добавляет элементы с указанными оценками в упорядоченное множество для заданного ключа
//
// Параметры:
//  ПараметрыСоединения - Структура    - Параметры для подключения
//                          * Адрес  - Строка - Адрес сервера Redis
//                          * Пароль - Строка - Пароль для подключения к серверу Redis
//                      - Произвольный - Объект TCP клиента когда команда вызывается для ранее
//                                       установленного соединения
//  Ключ                - Строка       - Ключ по которому будут схранены данные на сервере
//  Данные              - Массив Из Структура:
//                          * Оценка   - Число  - Целое положительное число по значению которого будет
//                                                проводится упорядочивание элементов множества
//                          * Значение - Строка - Значение элемента множества
//
// Возвращаемое значение:
//  Булево - 
//
Функция ДобавитьЭлементыВУпорядоченноеМножество(ПараметрыСоединения, Ключ, Данные) Экспорт

	ФорматнаяСтрокаДляЧисла = "ЧН=; ЧГ=0";

	Маркер = Маркер();
	Команда = СтрШаблон("*%1%4$4%4ZADD%4$%3%4%2%4",
		Формат(Данные.Количество() * 2 + 2, ФорматнаяСтрокаДляЧисла),
		Ключ, СтрДлинаВБайтах(Ключ),
		Маркер);
		
	Для каждого ЭлементМножества Из Данные Цикл
		ОценкаСтрокой = Формат(ЭлементМножества.Оценка, ФорматнаяСтрокаДляЧисла);
		Команда = Команда + СтрШаблон("$%2%5%1%5$%4%5%3%5",
			ОценкаСтрокой, Формат(СтрДлина(ОценкаСтрокой), ФорматнаяСтрокаДляЧисла),
			ЭлементМножества.Значение, СтрДлинаВБайтах(ЭлементМножества.Значение),
			Маркер);
	КонецЦикла;
	
	Если ТипЗнч(ПараметрыСоединения) = Тип("Структура") Тогда
		РезультатВызова = ВызовСервераRedis(ПараметрыСоединения, Команда);
	Иначе
		РезультатВызова = ВызовСервераRedisДляСоединения(ПараметрыСоединения, Команда);
	КонецЕсли;
	ПерваяСтрокаОтвета = СтрПолучитьСтроку(РезультатВызова, 1);
	Если СтрНачинаетсяС(ПерваяСтрокаОтвета, ":")
		И Число(СтрЗаменить(ПерваяСтрокаОтвета, ":", "")) = Данные.Количество() Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	ВызватьИсключение РезультатВызова;
	
КонецФункции

//
//
// Параметры:
//  ПараметрыСоединения - Структура    - Параметры для подключения
//                          * Адрес  - Строка - Адрес сервера Redis
//                          * Пароль - Строка - Пароль для подключения к серверу Redis
//                      - Произвольный - Объект TCP клиента когда команда вызывается для ранее
//                                       установленного соединения
//  Ключ                - Строка       - 
//  Начало              - Число        - 
//  Конец               - Число        - 
//  СОценкой            - Булево       - 
//
// Возвращаемое значение:
//
//
Функция ПолучитьЭлементыУпорядоченногоМножества(ПараметрыСоединения, Ключ, Начало = 0, Конец = -1,
	СОценкой = Ложь) Экспорт
	
	ФорматнаяСтрокаДляЧисла = "ЧН=; ЧГ=0";

	Маркер = Маркер();
	Команда = СтрШаблон("*4%7$6%7ZRANGE%7$%2%7%1%7$%4%7%3%7$%6%7%5%7",
		Ключ, СтрДлинаВБайтах(Ключ),
		Формат(Начало, ФорматнаяСтрокаДляЧисла), Формат(СтрДлина(Начало), ФорматнаяСтрокаДляЧисла),
		Формат(Конец, ФорматнаяСтрокаДляЧисла), Формат(СтрДлина(Конец), ФорматнаяСтрокаДляЧисла),
		Маркер);
		
	Если ТипЗнч(ПараметрыСоединения) = Тип("Структура") Тогда
		РезультатВызова = ВызовСервераRedis(ПараметрыСоединения, Команда);
	Иначе
		РезультатВызова = ВызовСервераRedisДляСоединения(ПараметрыСоединения, Команда);
	КонецЕсли;
	Если СтрНачинаетсяС(РезультатВызова, "*") Тогда
		
		Поля = "";
		Если СОценкой Тогда
			Поля = "Значение, Оценка";
		КонецЕсли;
		
		Возврат РазобратьОтветRedisКакМассив(РезультатВызова, Поля);
		
	КонецЕсли;

	ВызватьИсключение РезультатВызова;
	
КонецФункции

//
//
