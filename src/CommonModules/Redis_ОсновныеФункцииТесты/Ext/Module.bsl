	Соединение = Redis_ОсновныеФункции.ПолучитьСоединение(ПараметрыПодключенияКСерверуRedis);

	Для Сч = 1 По 100000 Цикл
		
		РезультатУстановки1 = Redis_ОсновныеФункции.УстановитьЗначение(Соединение,
			СтрШаблон("ТестовыйКлюч:%1", Формат(Сч, "ЧГ=")),
