Процедура ЗавершитьПроцессыИУдалитьФайлыСервера(ПутьКСерверу)
	
	WMI = ПолучитьCOMОбъект("winmgmts:");
	Процессы = WMI.ExecQuery("SELECT * FROM Win32_Process WHERE Name = 'redis-server.exe'");
	Для Каждого Процесс Из Процессы Цикл
		Процесс.Terminate();
	КонецЦикла;
	
	// Жду 5 секунд
	WshShell = Новый COMОбъект("WScript.Shell");
	WshShell.Run("cmd /c timeout /t 5 /nobreak", 0, Истина);
	WshShell = Неопределено;
	
	Файл = Новый Файл(ПутьКСерверу);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ПутьКСерверу, "*.*");
	КонецЕсли;
	
